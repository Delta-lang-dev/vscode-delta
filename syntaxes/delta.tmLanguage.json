{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Delta",
  "scopeName": "source.delta",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constructs" },
    { "include": "#raw-source" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.delta",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.delta",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.delta", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.delta",
          "match": "\\b(patch|fix|intent|migrate|guard|trace|apply|import|from|in|with|to|find|replace|why|scope|language|inject|where|assert|on_fail|follow|report|flag|severity|note|pattern|rename|move|remove|preserve|preview|fn|all|no|block)\\b"
        }
      ]
    },
    "constructs": {
      "patterns": [
        {
          "name": "entity.name.function.delta",
          "match": "(?<=\\bpatch\\s+\"[^\"]*\"\\s+in\\s+)\\w+"
        },
        {
          "name": "storage.type.delta",
          "match": "\\b(TypeScript|JavaScript|Python|Go|Rust|Java|Kotlin|Swift|Ruby|CPP|CSharp|PHP)\\b"
        }
      ]
    },
    "raw-source": {
      "name": "meta.embedded.block.delta",
      "begin": "(?<=\\b(?:find|replace|with|inject|pattern)\\b\\s*)\\{",
      "end": "\\}",
      "contentName": "source.embedded.delta",
      "patterns": [
        { "include": "source.ts" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.delta",
          "match": "->"
        },
        {
          "name": "punctuation.separator.colon.delta",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.delta",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
